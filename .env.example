# OpenAI API key — used by assignment 1. Get one at https://platform.openai.com/api-keys
OPEN_AI_API_KEY=

# Optional: override the model assignment 1 uses. Default is gpt-4o.
# OPENAI_MODEL=gpt-4o

# Groq API key — used by assignments 2 and 3. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model used by assignments 2 and 3.
# Default is openai/gpt-oss-120b, which is on Groq's free tier and supports tool calling.
# GROQ_MODEL=openai/gpt-oss-120b
